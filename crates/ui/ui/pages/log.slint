// Runtime log page. HMCL counterpart: ui/LogWindow.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { LogLine } from "../models.slint";

export component LogPage inherits Rectangle {
    in property <[LogLine]> lines;

    // -1 shows every level; otherwise the minimum level (0 trace .. 5 fatal).
    property <int> filter: -1;
    property <[string]> levels: ["ALL", "TRACE", "DEBUG", "INFO", "WARN", "ERROR"];
    property <bool> always-on-top: false;

    pure function level-bg(level: int) -> color {
        if level <= 1 { return #eee9e0; }
        if level == 2 { return #ffffff; }
        if level == 3 { return #fef6d5; }
        if level == 4 { return #fcebeb; }
        return #f7a699;
    }

    pure function is-active(index: int) -> bool {
        return index == 0 ? root.filter == -1 : root.filter == index - 1;
    }

    background: transparent;

    VerticalLayout {
        padding: Theme.space-10;
        spacing: Theme.space-8;

        HorizontalLayout {
            height: 30px;
            spacing: Theme.space-4;

            for level[index] in root.levels: Rectangle {
                width: level-text.preferred-width + Theme.space-16;
                height: 26px;
                border-radius: Theme.radius-4;
                border-width: 1px;
                border-color: root.is-active(index) ? Theme.primary : Theme.outline;
                background: root.is-active(index) ? Theme.primary : transparent;
                Text {
                    text: level;
                    color: root.is-active(index) ? Theme.on-primary : Theme.on-surface-variant;
                    font-size: Theme.font-size-12;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
                level-text := Text { text: level; font-size: Theme.font-size-12; visible: false; }
                lvl-ta := TouchArea {
                    clicked => { root.filter = index == 0 ? -1 : index - 1; }
                }
            }

            Rectangle { horizontal-stretch: 1; background: transparent; }

            Rectangle {
                width: 96px;
                height: 26px;
                border-radius: Theme.radius-4;
                border-width: 1px;
                border-color: root.always-on-top ? Theme.primary : Theme.outline;
                background: root.always-on-top ? Theme.primary : transparent;
                Text {
                    text: "始终置顶";
                    color: root.always-on-top ? Theme.on-primary : Theme.on-surface-variant;
                    font-size: Theme.font-size-12;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
                pin-ta := TouchArea { clicked => { root.always-on-top = !root.always-on-top; } }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: Theme.surface-container-lowest;
            border-radius: Theme.radius-4;
            clip: true;

            ScrollView {
                VerticalLayout {
                    spacing: 0;

                    if root.lines.length == 0: Rectangle {
                        height: 48px;
                        background: transparent;
                        Text {
                            x: Theme.space-16;
                            y: Theme.space-16;
                            text: "暂无日志。启动实例后这里会显示输出。";
                            color: Theme.on-surface-variant;
                            font-size: Theme.font-size-13;
                        }
                    }

                    for line in root.lines: Rectangle {
                        visible: root.filter == -1 || line.level >= root.filter;
                        height: Math.max(20px, line-text.preferred-height + 4px);
                        background: root.level-bg(line.level);
                        Text {
                            x: Theme.space-8;
                            y: 2px;
                            width: parent.width - Theme.space-16;
                            text: line.text;
                            font-family: "Consolas";
                            font-size: Theme.font-size-12;
                            color: Theme.on-surface;
                            overflow: elide;
                        }
                        line-text := Text {
                            text: line.text;
                            font-family: "Consolas";
                            font-size: Theme.font-size-12;
                            visible: false;
                        }
                    }
                }
            }
        }
    }
}
