// Plugin market page. HMCL counterpart: ui/instances/ModListPage + download lists.
import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { PageTitle, ActionButton } from "../components/common.slint";
import { PluginRow } from "../models.slint";

export component PluginsPage inherits Rectangle {
    in-out property <int> page;
    in property <[string]> installed-plugins;
    in property <[PluginRow]> plugins;
    in-out property <string> pending-remove-plugin;
    callback refresh-plugins(string);
    callback install-plugin(string, string, string);

    background: transparent;

    VerticalLayout {
        padding: Theme.space-24;
        spacing: Theme.space-12;
        PageTitle { label: "插件市场"; }
        Text { text: "仅显示当前实例有明确兼容证据的插件版本。"; color: Theme.on-surface-variant; font-size: Theme.font-size-13; }
        Rectangle { height: 145px; background: Theme.surface-container-lowest; border-radius: Theme.radius-4;
            VerticalLayout { padding: Theme.space-12; spacing: Theme.space-5;
                Text { text: "当前实例已安装"; font-size: Theme.font-size-15; font-weight: 700; color: Theme.on-surface; }
                ScrollView { vertical-stretch: 1;
                    VerticalLayout { spacing: Theme.space-5;
                        for package in root.installed-plugins: HorizontalLayout { height: 32px; spacing: Theme.space-8;
                            Text { text: package; font-size: Theme.font-size-13; color: Theme.on-surface-variant; horizontal-stretch: 1; vertical-alignment: center; }
                            ActionButton { width: 75px; label: "卸载"; clicked => { root.pending-remove-plugin = package; } }
                        }
                    }
                }
            }
        }
        HorizontalLayout { spacing: Theme.space-10;
            plugin-search := LineEdit { placeholder-text: "搜索 GitHub 插件仓库"; horizontal-stretch: 1; }
            ActionButton { width: 90px; label: "搜索"; clicked => { root.refresh-plugins(plugin-search.text); } }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout { spacing: Theme.space-8;
                for row in root.plugins: Rectangle {
                    height: 104px; background: Theme.surface-container-lowest; border-radius: Theme.radius-4;
                    VerticalLayout { padding: Theme.space-12; spacing: Theme.space-5;
                        Text { text: row.name + "  " + row.version; font-size: Theme.font-size-15; font-weight: 700; color: Theme.on-surface; }
                        Text { text: row.summary; color: Theme.on-surface-variant; font-size: Theme.font-size-12; overflow: elide; }
                        HorizontalLayout { spacing: Theme.space-8;
                            Text { text: row.package; font-size: Theme.font-size-12; color: Theme.on-surface-variant; horizontal-stretch: 1; vertical-alignment: center; }
                            ActionButton { width: 90px; label: "安装"; primary: true;
                                clicked => { root.install-plugin(row.package, row.version, row.repo); } }
                        }
                    }
                }
            }
        }
    }
}
