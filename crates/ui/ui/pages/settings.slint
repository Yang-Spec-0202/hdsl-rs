// Settings page. HMCL counterpart: ui/main/LauncherSettingsPage.
// Placeholder shell for S0b; tabs and rows are implemented in slice S5.
import { Theme } from "../theme.slint";
import { PageTitle } from "../components/common.slint";

export component SettingsPage inherits Rectangle {
    in-out property <int> page;

    background: transparent;

    VerticalLayout {
        padding: Theme.space-24;
        spacing: Theme.space-12;
        PageTitle { label: "设置"; }
        Text { text: "设置项待补充。模型路由、API Key 与端点请在实例的 Harness 网页中管理。";
            color: Theme.on-surface-variant; font-size: Theme.font-size-13; }
        Rectangle { vertical-stretch: 1; background: transparent; }
    }
}
