// Instance detail page. HMCL counterpart: ui/instances/GameInstancePage.
// Left sidebar mirrors AdvancedListBox (settings / installers / mods tabs plus
// the test / browse / manage toolbar); the content area switches on the tab.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { AdvancedListItem, AdvancedListBox } from "../components/navigation.slint";
import { ClassTitle, InstanceIcon, BorderButton } from "../components/common.slint";
import { ComponentList, OptionsList, ComponentSublist } from "../components/lists.slint";
import { LineRow, LineButton, LineSelectButton, LineToggleButton, LinePane, LineTextPane } from "../components/lines.slint";

export component InstanceDetailPage inherits Rectangle {
    in-out property <int> page;
    in property <string> instance-name;
    in property <string> instance-version;
    in property <string> instance-port;
    in property <string> instance-icon: "grass";
    in property <[string]> installed-plugins;
    callback choose-icon(string);

    property <int> tab: 0;
    property <bool> show-icon-dialog: false;
    // The app uses "未选择实例" as its no-selection sentinel.
    property <bool> has-instance: root.instance-name != "" && root.instance-name != "未选择实例";
    property <[string]> icon-names-a: ["grass", "chest", "chicken", "command", "april_fools", "optifine", "craft_table"];
    property <[string]> icon-names-b: ["fabric", "legacyfabric", "forge", "cleanroom", "neoforge", "furnace", "quilt"];
    property <int> java-index: 0;
    property <bool> version-isolated: false;
    property <string> memory: "2048 MB";

    background: transparent;

    HorizontalLayout {
        spacing: 0;

        // --- Left sidebar (AdvancedListBox + toolbar), width 200 ---
        Rectangle {
            width: Theme.sidebar-width;
            background: transparent;

            VerticalLayout {
                spacing: 0;

                AdvancedListBox {
                    ClassTitle { title: "实例"; }
                    AdvancedListItem {
                        title: root.instance-name;
                        subtitle: root.instance-version + "  :" + root.instance-port;
                        icon: "list-bulleted";
                    }
                    AdvancedListItem {
                        title: "实例设置";
                        icon: "settings";
                        selected: root.tab == 0;
                        clicked => { root.tab = 0; }
                    }
                    AdvancedListItem {
                        title: "版本组件";
                        icon: "deployed-code";
                        selected: root.tab == 1;
                        clicked => { root.tab = 1; }
                    }
                    AdvancedListItem {
                        title: "插件管理";
                        icon: "extension";
                        selected: root.tab == 2;
                        clicked => { root.tab = 2; }
                    }
                }

                Rectangle { vertical-stretch: 1; background: transparent; }

                // Bottom toolbar, mirrors HMCL instance.launch.test / browse / manage.
                AdvancedListBox {
                    list-padding-top: 0;
                    AdvancedListItem {
                        title: "测试游戏";
                        icon: "rocket-launch";
                        clicked => { }
                    }
                    AdvancedListItem {
                        title: "浏览";
                        icon: "folder-open";
                        clicked => { }
                    }
                    AdvancedListItem {
                        title: "管理";
                        icon: "menu";
                        clicked => { }
                    }
                }
            }
        }

        // --- Content area ---
        Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            if !root.has-instance: Text {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "没有选择实例";
                color: Theme.on-surface-variant;
                font-size: Theme.font-size-20;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // 实例设置
            if root.has-instance && root.tab == 0: ScrollView {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;

                VerticalLayout {
                    padding: Theme.space-10;
                    spacing: Theme.space-16;

                    ComponentList {
                        title: "游戏设置";
                        LinePane {
                            title: "游戏图标";
                            height: 64px;
                            InstanceIcon {
                                x: parent.width - Theme.space-16 - 32px;
                                y: (parent.height - 32px) / 2;
                                container-size: 32px;
                                name: root.instance-icon;
                            }
                            icon-pick-ta := TouchArea {
                                clicked => { root.show-icon-dialog = true; }
                            }
                        }
                        LineSelectButton {
                            title: "游戏 Java";
                            options: ["自动", "指定"];
                            selected-index <=> root.java-index;
                        }
                        LineToggleButton {
                            title: "版本隔离";
                            checked <=> root.version-isolated;
                        }
                        LineTextPane {
                            title: "游戏内存";
                            value: root.memory;
                        }
                        LineButton {
                            title: "高级选项";
                        }
                    }
                }
            }

            // 版本组件
            if root.has-instance && root.tab == 1: ScrollView {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;

                VerticalLayout {
                    padding: Theme.space-10;
                    spacing: Theme.space-16;

                    ComponentList {
                        title: "版本组件";
                        LineTextPane {
                            title: "Harness 版本";
                            value: root.instance-version;
                        }
                        LineTextPane {
                            title: "工作目录";
                            value: "实例目录";
                        }
                        LineTextPane {
                            title: "Web 端口";
                            value: root.instance-port;
                        }
                        LineButton {
                            title: "更换版本";
                            trailing-icon: "download";
                        }
                    }
                }
            }

            // 插件管理
            if root.has-instance && root.tab == 2: ScrollView {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;

                VerticalLayout {
                    padding: Theme.space-10;
                    spacing: Theme.space-16;

                    ComponentList {
                        title: "已安装插件";
                        if root.installed-plugins.length == 0: LineTextPane {
                            title: "没有已安装的插件";
                            value: "";
                        }
                        for package in root.installed-plugins: LineTextPane {
                            title: package;
                            value: "已启用";
                        }
                        LineButton {
                            title: "下载插件";
                            trailing-icon: "download";
                        }
                    }
                }
            }
        }
    }

    // Instance icon picker, mirrors HMCL GameInstanceIconDialog.
    if root.show-icon-dialog: Rectangle {
        background: #990e1c34;
        Rectangle {
            width: 400px;
            height: 232px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.surface-container-high;
            border-radius: Theme.radius-4;
            drop-shadow-color: #00000040;
            drop-shadow-blur: 12px;

            VerticalLayout {
                padding: Theme.space-20;
                spacing: Theme.space-12;

                Text {
                    text: "游戏图标";
                    color: Theme.on-surface;
                    font-size: Theme.font-size-20;
                    font-weight: 700;
                }

                HorizontalLayout {
                    spacing: Theme.space-8;
                    for icon-name in root.icon-names-a: Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: Theme.radius-4;
                        background: icon-ta-a.has-hover ? Theme.on-surface.with-alpha(0.06) : transparent;
                        InstanceIcon {
                            x: (parent.width - 32px) / 2;
                            y: (parent.height - 32px) / 2;
                            container-size: 32px;
                            name: icon-name;
                        }
                        icon-ta-a := TouchArea {
                            clicked => {
                                root.choose-icon(icon-name);
                                root.show-icon-dialog = false;
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }
                HorizontalLayout {
                    spacing: Theme.space-8;
                    for icon-name in root.icon-names-b: Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: Theme.radius-4;
                        background: icon-ta-b.has-hover ? Theme.on-surface.with-alpha(0.06) : transparent;
                        InstanceIcon {
                            x: (parent.width - 32px) / 2;
                            y: (parent.height - 32px) / 2;
                            container-size: 32px;
                            name: icon-name;
                        }
                        icon-ta-b := TouchArea {
                            clicked => {
                                root.choose-icon(icon-name);
                                root.show-icon-dialog = false;
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }

                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout {
                    alignment: end;
                    BorderButton { label: "取消"; clicked => { root.show-icon-dialog = false; } }
                }
            }
        }
    }
}
