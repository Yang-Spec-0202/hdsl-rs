// Instance detail page. HMCL counterpart: ui/instances/GameInstancePage.
// Left sidebar mirrors AdvancedListBox (settings / installers / mods tabs plus
// the test / browse / manage toolbar); the content area switches on the tab.
//
// The LineComponent family (../components/lines.slint) and the ComponentList
// container (../components/lists.slint) are not importable yet: lines.slint
// redeclares RippleArea.interactive, and lists.slint places @children inside a
// conditional ComponentSublist. This slice may only edit instance-detail.slint,
// so both are re-declared here as page-local components with the same metrics
// until the shared files are fixed.
import { ScrollView, Switch } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Icon } from "../icons.slint";
import { AdvancedListItem, AdvancedListBox } from "../components/navigation.slint";
import { ClassTitle } from "../components/common.slint";

// ComponentList: card group with a title header and a rounded surface.
component DetailList inherits Rectangle {
    in property <string> title: "";
    background: transparent;

    VerticalLayout {
        spacing: Theme.space-4;
        if root.title != "": HorizontalLayout {
            height: 30px;
            padding-left: Theme.space-16;
            alignment: start;
            Text {
                text: root.title;
                color: Theme.on-surface;
                font-size: Theme.font-size-14;
                vertical-alignment: center;
            }
        }
        Rectangle {
            background: Theme.surface-container-lowest;
            border-radius: Theme.radius-4;
            drop-shadow-color: #0000001f;
            drop-shadow-blur: 5px;
            drop-shadow-offset-y: 1px;
            VerticalLayout {
                spacing: 0;
                @children
            }
        }
    }
}

// LineRow: title (14px), optional subtitle (11px), trailing slot.
component DetailRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    in property <bool> enabled: true;
    in property <bool> interactive: false;
    callback clicked();

    height: root.subtitle == "" ? 48px : 64px;
    opacity: root.enabled ? 1 : 0.4;
    background: root.enabled && ta.has-hover ? Theme.on-surface.with-alpha(0.04) : transparent;

    VerticalLayout {
        x: Theme.space-16;
        y: 0;
        width: parent.width - Theme.space-16 * 2;
        height: parent.height;
        alignment: center;
        spacing: Theme.space-2;
        Text {
            text: root.title;
            color: Theme.on-surface;
            font-size: Theme.font-size-14;
            overflow: elide;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            color: Theme.on-surface-variant;
            font-size: Theme.font-size-11;
            wrap: word-wrap;
        }
    }
    @children
    ta := TouchArea {
        enabled: root.enabled && root.interactive;
        clicked => { root.clicked(); }
    }
}

// LineTextPane: read-only value on the right.
component DetailText inherits DetailRow {
    in property <string> value: "";

    Text {
        x: parent.width - Theme.space-16 - self.width;
        y: 0;
        height: parent.height;
        text: root.value;
        color: Theme.on-surface;
        font-size: Theme.font-size-14;
        vertical-alignment: center;
    }
}

// LineButton: trailing label and/or icon.
component DetailButton inherits DetailRow {
    in property <string> trailing: "";
    in property <string> trailing-icon: "unfold-more";

    interactive: true;

    Text {
        x: parent.width - Theme.space-16 - (root.trailing-icon != "" ? 28px : 0px) - self.width;
        y: 0;
        height: parent.height;
        text: root.trailing;
        color: Theme.on-surface-variant;
        font-size: Theme.font-size-14;
        vertical-alignment: center;
    }
    if root.trailing-icon != "": Icon {
        x: parent.width - Theme.space-16 - 20px;
        y: (parent.height - 20px) / 2;
        icon-size: 20px;
        name: root.trailing-icon;
        tint: Theme.on-surface-variant;
    }
}

// LineToggleButton: trailing switch.
component DetailToggle inherits DetailRow {
    in property <string> trailing: "";
    in-out property <bool> checked: false;

    Text {
        x: parent.width - Theme.space-16 - 48px - 12px - self.width;
        y: 0;
        height: parent.height;
        text: root.trailing;
        color: Theme.on-surface-variant;
        font-size: Theme.font-size-12;
        vertical-alignment: center;
    }
    Switch {
        x: parent.width - Theme.space-16 - 44px;
        y: (parent.height - 24px) / 2;
        width: 44px;
        height: 24px;
        checked: root.checked;
        enabled: root.enabled;
        toggled => { root.checked = self.checked; }
    }
}

// LineSelectButton: trailing dropdown.
component DetailSelect inherits DetailRow {
    in property <[string]> options;
    in-out property <int> selected-index: 0;
    property <bool> show-options: false;

    interactive: true;
    clicked => { root.show-options = !root.show-options; }

    Text {
        x: parent.width - Theme.space-16 - 24px - self.width;
        y: 0;
        height: parent.height;
        text: root.selected-index >= 0 && root.selected-index < root.options.length ? root.options[root.selected-index] : "";
        color: Theme.on-surface-variant;
        font-size: Theme.font-size-14;
        vertical-alignment: center;
    }
    Icon {
        x: parent.width - Theme.space-16 - 20px;
        y: (parent.height - 20px) / 2;
        icon-size: 20px;
        name: "unfold-more";
        tint: Theme.on-surface-variant;
    }
    PopupWindow {
        x: root.absolute-position.x + root.width - 180px;
        y: root.absolute-position.y + root.height;
        width: 180px;
        height: Math.min(root.options.length * 36px + 8px, 260px);
        visible: root.show-options;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.surface-container-low;
            border-radius: Theme.radius-4;
            drop-shadow-color: #00000040;
            drop-shadow-blur: 8px;
            VerticalLayout {
                padding: Theme.space-4;
                spacing: 0;
                for option[index] in root.options: Rectangle {
                    height: 36px;
                    background: index == root.selected-index
                        ? Theme.secondary-container
                        : (option-ta.has-hover ? Theme.on-surface.with-alpha(0.06) : transparent);
                    border-radius: Theme.radius-3;
                    Text {
                        x: Theme.space-12;
                        text: option;
                        color: Theme.on-surface;
                        font-size: Theme.font-size-13;
                        vertical-alignment: center;
                        height: parent.height;
                    }
                    option-ta := TouchArea {
                        clicked => {
                            root.selected-index = index;
                            root.show-options = false;
                        }
                    }
                }
            }
        }
    }
}

export component InstanceDetailPage inherits Rectangle {
    in-out property <int> page;
    in property <string> instance-name;
    in property <string> instance-version;
    in property <string> instance-port;

    property <int> tab: 0;
    // The app uses "未选择实例" as its no-selection sentinel.
    property <bool> has-instance: root.instance-name != "" && root.instance-name != "未选择实例";
    property <[string]> demo-plugins: ["@dsh/better-sidebar"];
    property <int> java-index: 0;
    property <bool> version-isolated: false;
    property <string> memory: "2048 MB";

    background: transparent;

    HorizontalLayout {
        spacing: 0;

        // --- Left sidebar (AdvancedListBox + toolbar), width 200 ---
        Rectangle {
            width: Theme.sidebar-width;
            background: transparent;

            VerticalLayout {
                spacing: 0;

                AdvancedListBox {
                    ClassTitle { title: "实例"; }
                    AdvancedListItem {
                        title: root.instance-name;
                        subtitle: root.instance-version + "  :" + root.instance-port;
                        icon: "list-bulleted";
                    }
                    AdvancedListItem {
                        title: "实例设置";
                        icon: "settings";
                        selected: root.tab == 0;
                        clicked => { root.tab = 0; }
                    }
                    AdvancedListItem {
                        title: "版本组件";
                        icon: "deployed-code";
                        selected: root.tab == 1;
                        clicked => { root.tab = 1; }
                    }
                    AdvancedListItem {
                        title: "插件管理";
                        icon: "extension";
                        selected: root.tab == 2;
                        clicked => { root.tab = 2; }
                    }
                }

                Rectangle { vertical-stretch: 1; background: transparent; }

                // Bottom toolbar, mirrors HMCL instance.launch.test / browse / manage.
                AdvancedListBox {
                    list-padding-top: 0;
                    AdvancedListItem {
                        title: "测试游戏";
                        icon: "rocket-launch";
                        clicked => { }
                    }
                    AdvancedListItem {
                        title: "浏览";
                        icon: "folder-open";
                        clicked => { }
                    }
                    AdvancedListItem {
                        title: "管理";
                        icon: "menu";
                        clicked => { }
                    }
                }
            }
        }

        // --- Content area ---
        Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            if !root.has-instance: Text {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                text: "没有选择实例";
                color: Theme.on-surface-variant;
                font-size: Theme.font-size-20;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // 实例设置
            if root.has-instance && root.tab == 0: ScrollView {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;

                VerticalLayout {
                    padding: Theme.space-10;
                    spacing: Theme.space-16;

                    DetailList {
                        title: "游戏设置";
                        DetailSelect {
                            title: "游戏 Java";
                            options: ["自动", "指定"];
                            selected-index <=> root.java-index;
                        }
                        DetailToggle {
                            title: "版本隔离";
                            checked <=> root.version-isolated;
                        }
                        DetailText {
                            title: "游戏内存";
                            value: root.memory;
                        }
                        DetailButton {
                            title: "高级选项";
                        }
                    }
                }
            }

            // 版本组件
            if root.has-instance && root.tab == 1: ScrollView {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;

                VerticalLayout {
                    padding: Theme.space-10;
                    spacing: Theme.space-16;

                    DetailList {
                        title: "版本组件";
                        DetailText {
                            title: "Harness 版本";
                            value: root.instance-version;
                        }
                        DetailText {
                            title: "工作目录";
                            value: "实例目录";
                        }
                        DetailText {
                            title: "Web 端口";
                            value: root.instance-port;
                        }
                        DetailButton {
                            title: "更换版本";
                            trailing-icon: "download";
                        }
                    }
                }
            }

            // 插件管理
            if root.has-instance && root.tab == 2: ScrollView {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;

                VerticalLayout {
                    padding: Theme.space-10;
                    spacing: Theme.space-16;

                    DetailList {
                        title: "已安装插件";
                        for package in root.demo-plugins: DetailText {
                            title: package;
                            value: "已启用";
                        }
                        DetailButton {
                            title: "下载插件";
                            trailing-icon: "download";
                        }
                    }
                }
            }
        }
    }
}
