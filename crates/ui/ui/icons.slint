// Icon component. Generated by scripts/gen-icons.ps1 from the staged reference set.
// Replace the reference assets with original artwork before release.
import { Theme } from "theme.slint";

export component Icon {
    in property <string> name;
    in property <length> icon-size: 24px;
    in property <color> tint: Theme.on-surface;
    in-out property <angle> rotation-angle: 0deg;
    width: icon-size;
    height: icon-size;
    animate rotation-angle { duration: 1s; iteration-count: -1; easing: linear; }
    if name == "add": Image { width: parent.width; height: parent.height; source: @image-url("assets/icons/add.svg"); colorize: tint; image-fit: contain; transform-rotation: root.rotation-angle; transform-origin: { x: parent.width / 2, y: parent.height / 2 }; }
