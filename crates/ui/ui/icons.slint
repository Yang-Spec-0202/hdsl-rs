    if name == "update": Image { width: parent.width; height: parent.height; source: @image-url("assets/icons/update.svg"); colorize: tint; image-fit: contain; transform-rotation: root.rotation-angle; transform-origin: { x: parent.width / 2, y: parent.height / 2 }; }
    if name == "visibility": Image { width: parent.width; height: parent.height; source: @image-url("assets/icons/visibility.svg"); colorize: tint; image-fit: contain; transform-rotation: root.rotation-angle; transform-origin: { x: parent.width / 2, y: parent.height / 2 }; }
    if name == "visibility-off": Image { width: parent.width; height: parent.height; source: @image-url("assets/icons/visibility-off.svg"); colorize: tint; image-fit: contain; transform-rotation: root.rotation-angle; transform-origin: { x: parent.width / 2, y: parent.height / 2 }; }
    if name == "warning": Image { width: parent.width; height: parent.height; source: @image-url("assets/icons/warning.svg"); colorize: tint; image-fit: contain; transform-rotation: root.rotation-angle; transform-origin: { x: parent.width / 2, y: parent.height / 2 }; }
    if name == "wb-sunny": Image { width: parent.width; height: parent.height; source: @image-url("assets/icons/wb-sunny.svg"); colorize: tint; image-fit: contain; transform-rotation: root.rotation-angle; transform-origin: { x: parent.width / 2, y: parent.height / 2 }; }
    if name == "wb-sunny-fill": Image { width: parent.width; height: parent.height; source: @image-url("assets/icons/wb-sunny-fill.svg"); colorize: tint; image-fit: contain; transform-rotation: root.rotation-angle; transform-origin: { x: parent.width / 2, y: parent.height / 2 }; }
}
