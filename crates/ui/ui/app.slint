import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { AdvancedListItem, AdvancedListBox } from "components/navigation.slint";
import { ClassTitle } from "components/common.slint";

export struct InstanceRow {
    id: string,
    name: string,
    version: string,
    workspace: string,
    port: string,
}

export struct PluginRow {
    name: string,
    package: string,
    version: string,
    summary: string,
    repo: string,
}

export struct VersionRow {
    version: string,
    label: string,
}

component PageTitle inherits Text {
    in property <string> label;
    text: label;
    color: Theme.on-surface;
    font-size: Theme.font-size-22;
    font-weight: 700;
    height: 38px;
    vertical-alignment: center;
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 34px;
    border-radius: Theme.radius-4;
    border-width: primary ? 0px : 1px;
    border-color: Theme.outline;
    background: primary ? Theme.primary : transparent;
    opacity: enabled ? 1 : 0.4;
    Text {
        text: root.label;
        color: primary ? Theme.on-primary : Theme.primary;
        font-size: Theme.font-size-14;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        background: ta.pressed ? Theme.on-surface.with-alpha(0.12) : (ta.has-hover ? Theme.on-surface.with-alpha(0.04) : transparent);
        animate background { duration: Theme.motion-short4; }
    }
}

// Title bar button, mirrors HMCL .jfx-decorator-button (40x40, icon 24).
component ShellButton inherits Rectangle {
    in property <string> icon;
    callback clicked();
    width: Theme.titlebar-height;
    height: Theme.titlebar-height;
    border-radius: Theme.radius-5;
    background: ta.has-hover ? Theme.on-primary-container.with-alpha(0.12) : transparent;
    animate background { duration: Theme.motion-short4; }
    Icon {
        x: (parent.width - 24px) / 2;
        y: (parent.height - 24px) / 2;
        icon-size: 24px;
        name: root.icon;
        tint: Theme.on-primary-container;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component AppWindow inherits Window {
    title: "HDSL · Hello DeepSeek Launcher";
    no-frame: true;
    width: 1080px;
    height: 700px;
    background: transparent;

    in-out property <[InstanceRow]> instances;
    in-out property <[PluginRow]> plugins;
    in-out property <[VersionRow]> available-versions;
    in-out property <int> available-version-count: 0;
    in-out property <[string]> installed-plugins;
    in-out property <string> status-text: "准备就绪";
    in-out property <string> log-text: "";
    in-out property <string> latest-version: "";
    in-out property <string> default-workspace: "";
    in-out property <string> active-instance-name: "未选择实例";
    in-out property <string> active-instance-version: "";
    in-out property <string> active-instance-port: "";
    in-out property <string> selected-id: "";
    in-out property <int> page: 0;
    in-out property <string> form-name: "我的 Harness";
    in-out property <string> form-version: "";
    in-out property <string> form-workspace: "";
    in-out property <string> account-name: "Xiao-Yu118";
    in-out property <image> account-avatar: @image-url("assets/account/avatar.jpg");
    property <string> pending-delete-id: "";
    property <string> pending-remove-plugin: "";
    in-out property <bool> approval-pending: false;
    in-out property <string> approval-title: "";
    in-out property <string> approval-body: "";

    callback select-instance(string);
    callback refresh-versions();
    callback open-upstream-report();
    callback create-instance(string, string, string, string);
    callback launch-instance();
    callback stop-instance();
    callback clone-instance(string);
    callback remove-instance(string);
    callback refresh-plugins(string);
    callback install-plugin(string, string, string);
    callback remove-plugin(string);
    callback open-help();
    callback approve-build(bool);

    // Frameless window with an 8px shadow inset and 8px content radius.
    Rectangle {
        x: Theme.window-shadow-inset;
        y: Theme.window-shadow-inset;
        width: parent.width - Theme.window-shadow-inset * 2;
        height: parent.height - Theme.window-shadow-inset * 2;
        border-radius: Theme.window-radius;
        background: Theme.surface-container;
        clip: true;
        drop-shadow-color: #00000066;
        drop-shadow-blur: 10px;
        drop-shadow-spread: 1px;
        drop-shadow-offset-x: 0;
        drop-shadow-offset-y: 0;

        VerticalLayout {
            spacing: 0;

            // --- Title bar / nav bar ---
            Rectangle {
                height: Theme.titlebar-height;
                background: Theme.primary-container;
                WindowMoveArea { }

                if root.page != 0: ShellButton {
                    x: 0;
                    icon: "arrow-back";
                    clicked => { root.page = 0; }
                }
                if root.page != 0: ShellButton {
                    x: Theme.titlebar-height;
                    icon: "home";
                    clicked => { root.page = 0; }
                }
                // Title node: icon + full title
                HorizontalLayout {
                    x: root.page == 0 ? Theme.space-12 : Theme.titlebar-height * 2 + Theme.space-4;
                    y: 0;
                    height: parent.height;
                    spacing: Theme.space-8;
                    Image {
                        width: 24px;
                        height: 24px;
                        source: @image-url("assets/branding/icon-title.png");
                        image-fit: contain;
                    }
                    Text {
                        text: "HDSL · Hello DeepSeek Launcher";
                        color: Theme.on-primary-container;
                        font-size: Theme.font-size-14;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                // Window buttons
                HorizontalLayout {
                    x: parent.width - Theme.titlebar-height * 3;
                    y: 0;
                    height: parent.height;
                    spacing: 0;
                    ShellButton { icon: "help"; clicked => { root.open-help(); } }
                    ShellButton { icon: "minimize-center"; clicked => { root.minimized = true; } }
                    ShellButton { icon: "close"; clicked => { root.close(); } }
                }
            }

            // --- Body: sidebar + content ---
            HorizontalLayout {
                spacing: 0;
                Rectangle {
                    width: Theme.sidebar-width;
                    background: Theme.surface-transparent-50;
                    AdvancedListBox {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        ClassTitle { title: "环境"; }
                        AdvancedListItem {
                            show-avatar: true;
                            avatar: root.account-avatar;
                            title: root.account-name == "" ? "GitHub" : root.account-name;
                            subtitle: "GitHub";
                        }
                        ClassTitle { title: "游戏"; }
                        AdvancedListItem {
                            title: "实例管理";
                            subtitle: root.active-instance-name;
                            icon: "list-bulleted";
                            selected: root.page == 2;
                            clicked => { root.page = 2; }
                        }
                        AdvancedListItem {
                            title: "实例列表";
                            icon: "list-bulleted";
                            selected: root.page == 2;
                            clicked => { root.page = 2; }
                        }
                        AdvancedListItem {
                            title: "下载";
                            icon: "download";
                            selected: root.page == 1;
                            clicked => { root.page = 1; root.refresh-versions(); }
                        }
                        ClassTitle { title: "通用"; }
                        AdvancedListItem {
                            title: "设置";
                            icon: "settings";
                            selected: root.page == 4;
                            clicked => { root.page = 4; }
                        }
                        AdvancedListItem {
                            title: "运行日志";
                            icon: "list-bulleted";
                            selected: root.page == 5;
                            clicked => { root.page = 5; }
                        }
                        AdvancedListItem {
                            title: "帮助";
                            icon: "help";
                            selected: false;
                            clicked => { root.open-help(); }
                        }
                    }
                    // Version footer
                    Text {
                        x: Theme.space-16;
                        y: parent.height - 28px;
                        text: "HDSL 0.1 · Rust";
                        color: Theme.on-surface-variant;
                        font-size: Theme.font-size-10;
                    }
                }

                Rectangle {
                    background: Theme.surface-transparent-50;

                    // --- Page: 首页 ---
                    if root.page == 0: VerticalLayout {
                        padding: Theme.space-24;
                        spacing: Theme.space-16;
                        PageTitle { label: "开始使用"; }
                        Rectangle {
                            height: 180px;
                            border-radius: Theme.radius-4;
                            background: Theme.primary-fixed;
                            VerticalLayout {
                                padding: Theme.space-24;
                                spacing: Theme.space-10;
                                Text { text: "让不同版本，住在各自的海域。"; font-size: Theme.font-size-22; font-weight: 700; color: Theme.on-primary-fixed; }
                                Text { text: "为每个 DeepSeek Harness 实例保存独立版本、插件和数据。"; font-size: Theme.font-size-14; color: Theme.on-primary-fixed-variant; }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                                HorizontalLayout {
                                    spacing: Theme.space-12;
                                    ActionButton { width: 150px; label: "安装新版本"; primary: true; clicked => { root.page = 1; root.refresh-versions(); } }
                                    ActionButton { width: 150px; label: "查看实例"; clicked => { root.page = 2; } }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                            }
                        }
                        Rectangle {
                            height: 130px;
                            background: Theme.surface-container-lowest;
                            border-radius: Theme.radius-4;
                            VerticalLayout {
                                padding: Theme.space-16;
                                spacing: Theme.space-8;
                                Text { text: "当前实例"; font-size: Theme.font-size-16; font-weight: 700; color: Theme.on-surface; }
                                Text { text: root.active-instance-name + "  " + root.active-instance-version; color: Theme.on-surface-variant; font-size: Theme.font-size-14; }
                                Text { text: "Web 端口：" + root.active-instance-port; color: Theme.on-surface-variant; font-size: Theme.font-size-13; }
                                HorizontalLayout { spacing: Theme.space-10;
                                    ActionButton { width: 110px; label: "启动"; primary: true; clicked => { root.launch-instance(); } }
                                    ActionButton { width: 110px; label: "停止"; clicked => { root.stop-instance(); } }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                }
                            }
                        }
                        Rectangle {
                            height: 100px;
                            background: Theme.tertiary-fixed;
                            border-radius: Theme.radius-4;
                            VerticalLayout { padding: Theme.space-12; spacing: Theme.space-5;
                                Text { text: "上游版本公告 · 2026-09-23"; font-size: Theme.font-size-15; font-weight: 700; color: Theme.on-tertiary-fixed; }
                                Text { text: "社区报告：0.1.5-rc.2 在 Windows 的 Web 启动可能失败；本地已复现 HMR 错误。";
                                    font-size: Theme.font-size-12; color: Theme.on-tertiary-fixed; wrap: word-wrap; }
                                ActionButton { width: 125px; height: 29px; label: "查看原始报告"; clicked => { root.open-upstream-report(); } }
                            }
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }

                    // --- Page: 安装新版本 ---
                    if root.page == 1: VerticalLayout {
                        padding: Theme.space-24;
                        spacing: Theme.space-8;
                        PageTitle { label: "安装新版本"; }
                        Text { text: "填写实例信息。下载会校验 Node.js 与 Harness 安装包。"; color: Theme.on-surface-variant; font-size: Theme.font-size-13; }
                        Text { text: "实例名称"; color: Theme.on-surface-variant; }
                        name-input := LineEdit { placeholder-text: "例如：日常开发"; text <=> root.form-name; }
                        Text { text: "Harness 版本"; color: Theme.on-surface-variant; }
                        HorizontalLayout { spacing: Theme.space-10;
                            version-input := LineEdit { text <=> root.form-version; placeholder-text: "例如 0.1.7-alpha.2"; horizontal-stretch: 1; }
                            ActionButton { width: 110px; label: "刷新目录"; clicked => { root.refresh-versions(); } }
                        }
                        Text { text: "npm 版本目录（含 alpha、beta、rc 预览版）；共 " + root.available-version-count + " 个版本，可滚动选择。";
                            color: Theme.on-surface-variant; font-size: Theme.font-size-12; }
                        Rectangle {
                            vertical-stretch: 1;
                            min-height: 150px;
                            background: Theme.surface-container-lowest;
                            border-radius: Theme.radius-4;
                            ScrollView {
                                VerticalLayout { spacing: Theme.space-4; padding: Theme.space-5;
                                    for row in root.available-versions: Rectangle {
                                        height: 32px; background: root.form-version == row.version ? Theme.secondary-container : Theme.surface-container-low;
                                        border-radius: Theme.radius-5;
                                        HorizontalLayout { padding-left: Theme.space-8; padding-right: Theme.space-6; spacing: Theme.space-8;
                                            Text { text: row.version; color: Theme.on-surface; font-size: Theme.font-size-13; horizontal-stretch: 1;
                                                vertical-alignment: center; }
                                            Text { text: row.label; color: Theme.tertiary; font-size: Theme.font-size-11; width: 90px;
                                                vertical-alignment: center; }
                                            ActionButton { width: 62px; height: 27px; label: "选择";
                                                clicked => { root.form-version = row.version; } }
                                        }
                                    }
                                }
                            }
                        }
                        Text { text: "工作目录"; color: Theme.on-surface-variant; }
                        workspace-input := LineEdit { text <=> root.form-workspace; placeholder-text: "工作区绝对路径"; }
                        Text { text: "Web 端口"; color: Theme.on-surface-variant; }
                        port-input := LineEdit { text: "3080"; }
                        ActionButton { width: 170px; label: "创建并安装"; primary: true;
                            clicked => { root.create-instance(name-input.text, version-input.text, workspace-input.text, port-input.text); } }
                    }

                    // --- Page: 实例管理 ---
                    if root.page == 2: VerticalLayout {
                        padding: Theme.space-24;
                        spacing: Theme.space-12;
                        PageTitle { label: "实例管理"; }
                        Text { text: "选择实例后可启动、复制到新版本或删除。"; color: Theme.on-surface-variant; font-size: Theme.font-size-13; }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: Theme.space-8;
                                for row in root.instances: Rectangle {
                                    height: 96px; background: root.selected-id == row.id ? Theme.secondary-container : Theme.surface-container-lowest;
                                    border-radius: Theme.radius-4;
                                    VerticalLayout { padding: Theme.space-12; spacing: Theme.space-5;
                                        Text { text: row.name + "  ·  " + row.version; font-size: Theme.font-size-16; font-weight: 700; color: Theme.on-surface; }
                                        Text { text: row.workspace; font-size: Theme.font-size-12; color: Theme.on-surface-variant; }
                                        HorizontalLayout { spacing: Theme.space-8;
                                            ActionButton { width: 82px; label: "选择"; clicked => { root.selected-id = row.id; root.select-instance(row.id); } }
                                            ActionButton { width: 82px; label: "启动"; clicked => { root.selected-id = row.id; root.select-instance(row.id); root.launch-instance(); } }
                                            ActionButton { width: 100px; label: "复制版本"; clicked => { root.clone-instance(row.id); } }
                                            ActionButton { width: 82px; label: "删除"; clicked => { root.pending-delete-id = row.id; } }
                                            Rectangle { horizontal-stretch: 1; background: transparent; }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // --- Page: 插件市场 ---
                    if root.page == 3: VerticalLayout {
                        padding: Theme.space-24;
                        spacing: Theme.space-12;
                        PageTitle { label: "插件市场"; }
                        Text { text: "仅显示当前实例有明确兼容证据的插件版本。"; color: Theme.on-surface-variant; font-size: Theme.font-size-13; }
                        Rectangle { height: 145px; background: Theme.surface-container-lowest; border-radius: Theme.radius-4;
                            VerticalLayout { padding: Theme.space-12; spacing: Theme.space-5;
                                Text { text: "当前实例已安装"; font-size: Theme.font-size-15; font-weight: 700; color: Theme.on-surface; }
                                ScrollView { vertical-stretch: 1;
                                    VerticalLayout { spacing: Theme.space-5;
                                        for package in root.installed-plugins: HorizontalLayout { height: 32px; spacing: Theme.space-8;
                                            Text { text: package; font-size: Theme.font-size-13; color: Theme.on-surface-variant; horizontal-stretch: 1; vertical-alignment: center; }
                                            ActionButton { width: 75px; label: "卸载"; clicked => { root.pending-remove-plugin = package; } }
                                        }
                                    }
                                }
                            }
                        }
                        HorizontalLayout { spacing: Theme.space-10;
                            plugin-search := LineEdit { placeholder-text: "搜索 GitHub 插件仓库"; horizontal-stretch: 1; }
                            ActionButton { width: 90px; label: "搜索"; clicked => { root.refresh-plugins(plugin-search.text); } }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout { spacing: Theme.space-8;
                                for row in root.plugins: Rectangle {
                                    height: 104px; background: Theme.surface-container-lowest; border-radius: Theme.radius-4;
                                    VerticalLayout { padding: Theme.space-12; spacing: Theme.space-5;
                                        Text { text: row.name + "  " + row.version; font-size: Theme.font-size-15; font-weight: 700; color: Theme.on-surface; }
                                        Text { text: row.summary; color: Theme.on-surface-variant; font-size: Theme.font-size-12; overflow: elide; }
                                        HorizontalLayout { spacing: Theme.space-8;
                                            Text { text: row.package; font-size: Theme.font-size-12; color: Theme.on-surface-variant; horizontal-stretch: 1; vertical-alignment: center; }
                                            ActionButton { width: 90px; label: "安装"; primary: true;
                                                clicked => { root.install-plugin(row.package, row.version, row.repo); } }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // --- Page: 设置 ---
                    if root.page == 4: VerticalLayout {
                        padding: Theme.space-24;
                        spacing: Theme.space-12;
                        PageTitle { label: "设置"; }
                        Text { text: "设置项待补充。模型路由、API Key 与端点请在实例的 Harness 网页中管理。";
                            color: Theme.on-surface-variant; font-size: Theme.font-size-13; }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }

                    // --- Page: 运行日志 ---
                    if root.page == 5: VerticalLayout {
                        padding: Theme.space-24;
                        spacing: Theme.space-12;
                        PageTitle { label: "运行日志"; }
                        ScrollView { vertical-stretch: 1;
                            Text { text: root.log-text; font-family: "Consolas"; font-size: Theme.font-size-12; color: Theme.on-surface; wrap: word-wrap; }
                        }
                    }
                }
            }

            // --- Status bar ---
            Rectangle {
                height: 28px;
                background: Theme.surface-container-high;
                Text {
                    x: Theme.space-10;
                    text: root.status-text;
                    color: Theme.on-surface-variant;
                    font-size: Theme.font-size-12;
                    vertical-alignment: center;
                    height: parent.height;
                }
            }
        }
    }

    if root.pending-delete-id != "": Rectangle {
        background: #990e1c34;
        Rectangle { width: 370px; height: 165px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Theme.surface-container-high; border-radius: Theme.radius-4;
            VerticalLayout { padding: Theme.space-20; spacing: Theme.space-12;
                Text { text: "删除实例？"; font-size: Theme.font-size-18; font-weight: 700; color: Theme.on-surface; }
                Text { text: "实例目录及其中的 Harness 数据将被删除。"; font-size: Theme.font-size-13; color: Theme.on-surface-variant; }
                HorizontalLayout { spacing: Theme.space-10;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ActionButton { width: 95px; label: "取消"; clicked => { root.pending-delete-id = ""; } }
                    ActionButton { width: 95px; label: "确认删除"; primary: true;
                        clicked => { root.remove-instance(root.pending-delete-id); root.pending-delete-id = ""; } }
                }
            }
        }
    }
    if root.pending-remove-plugin != "": Rectangle {
        background: #990e1c34;
        Rectangle { width: 410px; height: 165px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Theme.surface-container-high; border-radius: Theme.radius-4;
            VerticalLayout { padding: Theme.space-20; spacing: Theme.space-12;
                Text { text: "卸载插件？"; font-size: Theme.font-size-18; font-weight: 700; color: Theme.on-surface; }
                Text { text: root.pending-remove-plugin; font-size: Theme.font-size-13; color: Theme.on-surface-variant; overflow: elide; }
                HorizontalLayout { spacing: Theme.space-10;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ActionButton { width: 95px; label: "取消"; clicked => { root.pending-remove-plugin = ""; } }
                    ActionButton { width: 95px; label: "确认卸载"; primary: true;
                        clicked => { root.remove-plugin(root.pending-remove-plugin); root.pending-remove-plugin = ""; } }
                }
            }
        }
    }
    if root.approval-pending: Rectangle {
        background: #bb0e1c34;
        Rectangle { width: 570px; height: 380px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Theme.surface-container-high; border-radius: Theme.radius-4;
            VerticalLayout { padding: Theme.space-22; spacing: Theme.space-12;
                Text { text: root.approval-title; font-size: Theme.font-size-18; font-weight: 700; color: Theme.on-surface; }
                Text { text: "此包将执行以下构建脚本。请逐项检查后决定。"; font-size: Theme.font-size-13; color: Theme.on-surface-variant; }
                ScrollView { vertical-stretch: 1;
                    Text { text: root.approval-body; font-family: "Consolas"; font-size: Theme.font-size-12; color: Theme.on-surface; wrap: word-wrap; }
                }
                HorizontalLayout { spacing: Theme.space-10;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ActionButton { width: 95px; label: "拒绝"; clicked => { root.approval-pending = false; root.approve-build(false); } }
                    ActionButton { width: 95px; label: "允许这次"; primary: true;
                        clicked => { root.approval-pending = false; root.approve-build(true); } }
                }
            }
        }
    }
}
