import { LineEdit, ScrollView } from "std-widgets.slint";

export struct InstanceRow {
    id: string,
    name: string,
    version: string,
    workspace: string,
    port: string,
}

export struct PluginRow {
    name: string,
    package: string,
    version: string,
    summary: string,
    repo: string,
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 45px;
    border-radius: 8px;
    background: active ? #e5ebfb : transparent;
    Text {
        x: 18px; y: 11px; width: parent.width - 30px;
        text: label;
        color: active ? #2854a5 : #546174;
        font-size: 15px;
        font-weight: active ? 700 : 400;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked();
    height: 38px;
    border-radius: 7px;
    background: primary ? #3574d5 : #edf2fa;
    Text {
        text: label;
        color: primary ? white : #2f4f80;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component PageTitle inherits Text {
    in property <string> label;
    text: label;
    color: #1e2c42;
    font-size: 26px;
    font-weight: 700;
    height: 42px;
}

export component AppWindow inherits Window {
    title: "HDSL · Hello DeepSeek Launcher";
    width: 1080px;
    height: 700px;
    background: #f4f6fa;

    in-out property <[InstanceRow]> instances;
    in-out property <[PluginRow]> plugins;
    in-out property <[string]> installed-plugins;
    in-out property <string> status-text: "准备就绪";
    in-out property <string> log-text: "";
    in-out property <string> latest-version: "";
    in-out property <string> default-workspace: "";
    in-out property <bool> api-key-configured: false;
    in-out property <string> active-instance-name: "未选择实例";
    in-out property <string> active-instance-version: "";
    in-out property <string> active-instance-port: "";
    in-out property <string> selected-id: "";
    in-out property <int> page: 0;
    in-out property <string> form-name: "我的 Harness";
    in-out property <string> form-version: "";
    in-out property <string> form-workspace: "";
    property <string> pending-delete-id: "";
    property <string> pending-remove-plugin: "";
    in-out property <bool> approval-pending: false;
    in-out property <string> approval-title: "";
    in-out property <string> approval-body: "";

    callback select-instance(string);
    callback refresh-versions();
    callback create-instance(string, string, string, string);
    callback launch-instance();
    callback stop-instance();
    callback clone-instance(string);
    callback remove-instance(string);
    callback refresh-plugins(string);
    callback install-plugin(string, string, string);
    callback remove-plugin(string);
    callback save-api(string, string, string);
    callback open-web-settings();
    callback open-help();
    callback approve-build(bool);

    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: 230px;
            background: #eaf0f8;
            VerticalLayout {
                padding: 18px;
                spacing: 7px;
                Rectangle {
                    height: 92px;
                    background: transparent;
                    Image { x: 4px; y: 8px; width: 45px; height: 45px;
                        source: @image-url("assets/hdsl-mark.svg"); image-fit: contain; }
                    Text { x: 61px; y: 8px; text: "HDSL"; color: #1e3d70; font-size: 23px; font-weight: 700; }
                    Text { x: 61px; y: 40px; text: "DeepSeek 启动器"; color: #718198; font-size: 11px; }
                }
                NavItem { label: "首页"; active: root.page == 0; clicked => { root.page = 0; } }
                NavItem { label: "安装新版本"; active: root.page == 1; clicked => { root.page = 1; root.refresh-versions(); } }
                NavItem { label: "实例管理"; active: root.page == 2; clicked => { root.page = 2; } }
                NavItem { label: "插件市场"; active: root.page == 3; clicked => { root.page = 3; root.refresh-plugins(""); } }
                NavItem { label: "API 与设置"; active: root.page == 4; clicked => { root.page = 4; } }
                NavItem { label: "运行日志"; active: root.page == 5; clicked => { root.page = 5; } }
                Rectangle { vertical-stretch: 1; background: transparent; }
                NavItem { label: "帮助文档"; active: false; clicked => { root.open-help(); } }
                Text { text: "HDSL 0.1  ·  Rust"; color: #8895a7; font-size: 11px; height: 25px; }
            }
        }
        Rectangle {
            background: #f8f9fc;
            VerticalLayout {
                padding: 26px;
                spacing: 17px;
                if root.page == 0: VerticalLayout {
                    spacing: 18px;
                    PageTitle { label: "开始使用"; }
                    Rectangle {
                        height: 190px; border-radius: 12px; background: #e1ecfb;
                        VerticalLayout {
                            padding: 25px; spacing: 10px;
                            Text { text: "让不同版本，住在各自的海域。"; font-size: 24px; font-weight: 700; color: #264c83; }
                            Text { text: "为每个 DeepSeek Harness 实例保存独立版本、插件和数据。"; font-size: 14px; color: #4e6c91; }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                            HorizontalLayout {
                                spacing: 12px;
                                ActionButton { width: 150px; label: "安装新版本"; primary: true; clicked => { root.page = 1; root.refresh-versions(); } }
                                ActionButton { width: 150px; label: "查看实例"; clicked => { root.page = 2; } }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }
                        }
                    }
                    Rectangle {
                        height: 145px; background: white; border-radius: 10px;
                        VerticalLayout {
                            padding: 18px; spacing: 10px;
                            Text { text: "当前实例"; font-size: 17px; font-weight: 700; color: #253851; }
                            Text { text: root.active-instance-name + "  " + root.active-instance-version; color: #50647f; font-size: 14px; }
                            Text { text: "Web 端口：" + root.active-instance-port; color: #718198; font-size: 13px; }
                            HorizontalLayout { spacing: 10px;
                                ActionButton { width: 110px; label: "启动"; primary: true; clicked => { root.launch-instance(); } }
                                ActionButton { width: 110px; label: "停止"; clicked => { root.stop-instance(); } }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
                if root.page == 1: VerticalLayout {
                    spacing: 12px;
                    PageTitle { label: "安装新版本"; }
                    Text { text: "填写实例信息。下载会校验 Node.js 与 Harness 安装包。"; color: #718198; font-size: 13px; }
                    Text { text: "实例名称"; color: #3c506d; }
                    name-input := LineEdit { placeholder-text: "例如：日常开发"; text <=> root.form-name; }
                    Text { text: "Harness 版本"; color: #3c506d; }
                    HorizontalLayout { spacing: 10px;
                        version-input := LineEdit { text <=> root.form-version; placeholder-text: "例如 0.1.5-rc.3"; horizontal-stretch: 1; }
                        ActionButton { width: 110px; label: "获取最新"; clicked => { root.refresh-versions(); } }
                    }
                    Text { text: "工作目录"; color: #3c506d; }
                    workspace-input := LineEdit { text <=> root.form-workspace; placeholder-text: "工作区绝对路径"; }
                    Text { text: "Web 端口"; color: #3c506d; }
                    port-input := LineEdit { text: "3080"; }
                    ActionButton { width: 170px; label: "创建并安装"; primary: true;
                        clicked => { root.create-instance(name-input.text, version-input.text, workspace-input.text, port-input.text); } }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
                if root.page == 2: VerticalLayout {
                    spacing: 12px;
                    PageTitle { label: "实例管理"; }
                    Text { text: "选择实例后可启动、复制到新版本或删除。"; color: #718198; font-size: 13px; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 9px;
                            for row in root.instances: Rectangle {
                                height: 100px; background: root.selected-id == row.id ? #e6effe : white;
                                border-radius: 9px;
                                VerticalLayout { padding: 13px; spacing: 5px;
                                    Text { text: row.name + "  ·  " + row.version; font-size: 17px; font-weight: 700; color: #253851; }
                                    Text { text: row.workspace; font-size: 12px; color: #718198; }
                                    HorizontalLayout { spacing: 8px;
                                        ActionButton { width: 82px; label: "选择"; clicked => { root.selected-id = row.id; root.select-instance(row.id); } }
                                        ActionButton { width: 82px; label: "启动"; clicked => { root.selected-id = row.id; root.select-instance(row.id); root.launch-instance(); } }
                                        ActionButton { width: 100px; label: "复制版本"; clicked => { root.clone-instance(row.id); } }
                                        ActionButton { width: 82px; label: "删除"; clicked => { root.pending-delete-id = row.id; } }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                }
                            }
                        }
                    }
                }
                if root.page == 3: VerticalLayout {
                    spacing: 12px;
                    PageTitle { label: "插件市场"; }
                    Text { text: "仅显示当前实例有明确兼容证据的插件版本。"; color: #718198; font-size: 13px; }
                    Rectangle { height: 155px; background: white; border-radius: 9px;
                        VerticalLayout { padding: 12px; spacing: 5px;
                            Text { text: "当前实例已安装"; font-size: 16px; font-weight: 700; color: #253851; }
                            ScrollView { vertical-stretch: 1;
                                VerticalLayout { spacing: 5px;
                                    for package in root.installed-plugins: HorizontalLayout { height: 35px; spacing: 8px;
                                        Text { text: package; font-size: 13px; color: #50647f; horizontal-stretch: 1; }
                                        ActionButton { width: 75px; label: "卸载"; clicked => { root.pending-remove-plugin = package; } }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout { spacing: 10px;
                        plugin-search := LineEdit { placeholder-text: "搜索 GitHub 插件仓库"; horizontal-stretch: 1; }
                        ActionButton { width: 90px; label: "搜索"; clicked => { root.refresh-plugins(plugin-search.text); } }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout { spacing: 9px;
                            for row in root.plugins: Rectangle {
                                height: 112px; background: white; border-radius: 9px;
                                VerticalLayout { padding: 12px; spacing: 5px;
                                    Text { text: row.name + "  " + row.version; font-size: 16px; font-weight: 700; color: #253851; }
                                    Text { text: row.summary; color: #65758a; font-size: 12px; overflow: elide; }
                                    HorizontalLayout { spacing: 8px;
                                        Text { text: row.package; font-size: 12px; color: #718198; horizontal-stretch: 1; }
                                        ActionButton { width: 90px; label: "安装"; primary: true;
                                            clicked => { root.install-plugin(row.package, row.version, row.repo); } }
                                    }
                                }
                            }
                        }
                    }
                }
                if root.page == 4: VerticalLayout {
                    spacing: 12px;
                    PageTitle { label: "API 与设置"; }
                    Text { text: "当前实例：" + root.active-instance-name; color: #718198; font-size: 13px; }
                    Rectangle { height: 305px; background: white; border-radius: 9px;
                        VerticalLayout { padding: 18px; spacing: 9px;
                            Text { text: "DeepSeek 官方 API"; font-size: 17px; font-weight: 700; color: #253851; }
                            Text { text: root.api-key-configured ? "API Key 已配置（不可回显）" : "API Key 未配置"; color: #718198; font-size: 12px; }
                            api-key := LineEdit { placeholder-text: "输入新的 API Key；留空则不修改"; input-type: password; }
                            Text { text: "API Base URL（可选）"; color: #3c506d; }
                            api-url := LineEdit { placeholder-text: "https://api.deepseek.com"; }
                            Text { text: "新会话默认模型（可选）"; color: #3c506d; }
                            api-model := LineEdit { placeholder-text: "deepseek-v4-flash"; }
                            HorizontalLayout { spacing: 10px;
                                ActionButton { width: 120px; label: "保存"; primary: true;
                                    clicked => { root.save-api(api-key.text, api-url.text, api-model.text); api-key.text = ""; } }
                                ActionButton { width: 180px; label: "打开 Harness 网页"; clicked => { root.open-web-settings(); } }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }
                        }
                    }
                    Text { text: "其他提供商与第三方认证请在 Harness 原生界面或插件中配置。"; color: #718198; font-size: 12px; }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
                if root.page == 5: VerticalLayout {
                    spacing: 12px;
                    PageTitle { label: "运行日志"; }
                    ScrollView { vertical-stretch: 1;
                        Text { text: root.log-text; font-family: "Consolas"; font-size: 12px; color: #34435a; wrap: word-wrap; }
                    }
                }
                Rectangle { height: 31px; background: #e8edf5; border-radius: 6px;
                    Text { x: 10px; text: root.status-text; color: #5e6e84; font-size: 12px;
                        vertical-alignment: center; }
                }
            }
        }
    }
    if root.pending-delete-id != "": Rectangle {
        background: #990e1c34;
        Rectangle { width: 370px; height: 165px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: white; border-radius: 10px;
            VerticalLayout { padding: 20px; spacing: 12px;
                Text { text: "删除实例？"; font-size: 18px; font-weight: 700; color: #263a57; }
                Text { text: "实例目录及其中的 Harness 数据将被删除。"; font-size: 13px; color: #6a778b; }
                HorizontalLayout { spacing: 10px;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ActionButton { width: 95px; label: "取消"; clicked => { root.pending-delete-id = ""; } }
                    ActionButton { width: 95px; label: "确认删除"; primary: true;
                        clicked => { root.remove-instance(root.pending-delete-id); root.pending-delete-id = ""; } }
                }
            }
        }
    }
    if root.pending-remove-plugin != "": Rectangle {
        background: #990e1c34;
        Rectangle { width: 410px; height: 165px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: white; border-radius: 10px;
            VerticalLayout { padding: 20px; spacing: 12px;
                Text { text: "卸载插件？"; font-size: 18px; font-weight: 700; color: #263a57; }
                Text { text: root.pending-remove-plugin; font-size: 13px; color: #6a778b; overflow: elide; }
                HorizontalLayout { spacing: 10px;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ActionButton { width: 95px; label: "取消"; clicked => { root.pending-remove-plugin = ""; } }
                    ActionButton { width: 95px; label: "确认卸载"; primary: true;
                        clicked => { root.remove-plugin(root.pending-remove-plugin); root.pending-remove-plugin = ""; } }
                }
            }
        }
    }
    if root.approval-pending: Rectangle {
        background: #bb0e1c34;
        Rectangle { width: 570px; height: 380px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: white; border-radius: 10px;
            VerticalLayout { padding: 22px; spacing: 12px;
                Text { text: root.approval-title; font-size: 18px; font-weight: 700; color: #263a57; }
                Text { text: "此包将执行以下构建脚本。请逐项检查后决定。"; font-size: 13px; color: #6a778b; }
                ScrollView { vertical-stretch: 1;
                    Text { text: root.approval-body; font-family: "Consolas"; font-size: 12px; color: #34435a; wrap: word-wrap; }
                }
                HorizontalLayout { spacing: 10px;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ActionButton { width: 95px; label: "拒绝"; clicked => { root.approval-pending = false; root.approve-build(false); } }
                    ActionButton { width: 95px; label: "允许这次"; primary: true;
                        clicked => { root.approval-pending = false; root.approve-build(true); } }
                }
            }
        }
    }
}
