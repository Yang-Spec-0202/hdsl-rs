import { LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { AdvancedListItem, AdvancedListBox } from "components/navigation.slint";
import { ClassTitle, ActionButton } from "components/common.slint";
import { InstanceRow, PluginRow, VersionRow } from "models.slint";
import { HomePage } from "pages/home.slint";
import { InstallPage } from "pages/install.slint";
import { InstancesPage } from "pages/instances.slint";
import { PluginsPage } from "pages/plugins.slint";
import { SettingsPage } from "pages/settings.slint";
import { LogPage } from "pages/log.slint";
import { InstanceDetailPage } from "pages/instance-detail.slint";

export { InstanceRow, PluginRow, VersionRow }

// Title bar button, mirrors HMCL .jfx-decorator-button (40x40, icon 24).
component ShellButton inherits Rectangle {
    in property <string> icon;
    callback clicked();
    width: Theme.titlebar-height;
    height: Theme.titlebar-height;
    border-radius: Theme.radius-5;
    background: ta.has-hover ? Theme.on-primary-container.with-alpha(0.12) : transparent;
    animate background { duration: Theme.motion-short4; }
    Icon {
        x: (parent.width - 24px) / 2;
        y: (parent.height - 24px) / 2;
        icon-size: 24px;
        name: root.icon;
        tint: Theme.on-primary-container;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

export component AppWindow inherits Window {
    title: "HDSL · Hello DeepSeek Launcher";
    no-frame: true;
    width: 1080px;
    height: 700px;
    background: transparent;

    in-out property <[InstanceRow]> instances;
    in-out property <[PluginRow]> plugins;
    in-out property <[VersionRow]> available-versions;
    in-out property <int> available-version-count: 0;
    in-out property <[string]> installed-plugins;
    in-out property <string> status-text: "准备就绪";
    in-out property <string> log-text: "";
    in-out property <string> latest-version: "";
    in-out property <string> default-workspace: "";
    in-out property <string> active-instance-name: "未选择实例";
    in-out property <string> active-instance-version: "";
    in-out property <string> active-instance-port: "";
    in-out property <string> selected-id: "";
    in-out property <int> page: 0;
    in-out property <string> form-name: "我的 Harness";
    in-out property <string> form-version: "";
    in-out property <string> form-workspace: "";
    in-out property <string> account-name: "Xiao-Yu118";
    in-out property <image> account-avatar: @image-url("assets/account/avatar.jpg");
    property <string> pending-delete-id: "";
    property <string> pending-remove-plugin: "";
    in-out property <bool> approval-pending: false;
    in-out property <string> approval-title: "";
    in-out property <string> approval-body: "";

    callback select-instance(string);
    callback refresh-versions();
    callback refresh-instances();
    callback open-upstream-report();
    callback create-instance(string, string, string, string);
    callback launch-instance();
    callback stop-instance();
    callback clone-instance(string);
    callback remove-instance(string);
    callback refresh-plugins(string);
    callback install-plugin(string, string, string);
    callback remove-plugin(string);
    callback open-help();
    callback approve-build(bool);

    // Frameless window with an 8px shadow inset and 8px content radius.
    Rectangle {
        x: Theme.window-shadow-inset;
        y: Theme.window-shadow-inset;
        width: parent.width - Theme.window-shadow-inset * 2;
        height: parent.height - Theme.window-shadow-inset * 2;
        border-radius: Theme.window-radius;
        background: Theme.surface-container;
        clip: true;
        drop-shadow-color: #00000066;
        drop-shadow-blur: 10px;
        drop-shadow-spread: 1px;
        drop-shadow-offset-x: 0;
        drop-shadow-offset-y: 0;

        VerticalLayout {
            spacing: 0;

            // --- Title bar / nav bar ---
            Rectangle {
                height: Theme.titlebar-height;
                background: Theme.primary-container;
                WindowMoveArea { }

                if root.page != 0: ShellButton {
                    x: 0;
                    icon: "arrow-back";
                    clicked => { root.page = 0; }
                }
                if root.page != 0: ShellButton {
                    x: Theme.titlebar-height;
                    icon: "home";
                    clicked => { root.page = 0; }
                }
                HorizontalLayout {
                    x: root.page == 0 ? Theme.space-12 : Theme.titlebar-height * 2 + Theme.space-4;
                    y: 0;
                    height: parent.height;
                    spacing: Theme.space-8;
                    Image {
                        width: 24px;
                        height: 24px;
                        source: @image-url("assets/branding/icon-title.svg");
                        image-fit: contain;
                    }
                    Text {
                        text: "HDSL · Hello DeepSeek Launcher";
                        color: Theme.on-primary-container;
                        font-size: Theme.font-size-14;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    x: parent.width - Theme.titlebar-height * 3;
                    y: 0;
                    height: parent.height;
                    spacing: 0;
                    ShellButton { icon: "help"; clicked => { root.open-help(); } }
                    ShellButton { icon: "minimize-center"; clicked => { root.minimized = true; } }
                    ShellButton { icon: "close"; clicked => { root.close(); } }
                }
            }

            // --- Body: sidebar + content ---
            HorizontalLayout {
                spacing: 0;
                Rectangle {
                    width: Theme.sidebar-width;
                    background: Theme.surface-transparent-50;
                    AdvancedListBox {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        ClassTitle { title: "环境"; }
                        AdvancedListItem {
                            show-avatar: true;
                            avatar: root.account-avatar;
                            title: root.account-name == "" ? "GitHub" : root.account-name;
                            subtitle: "GitHub";
                        }
                        ClassTitle { title: "游戏"; }
                        AdvancedListItem {
                            title: "实例管理";
                            subtitle: root.active-instance-name;
                            icon: "list-bulleted";
                            selected: root.page == 6;
                            clicked => { root.page = 6; }
                        }
                        AdvancedListItem {
                            title: "实例列表";
                            icon: "list-bulleted";
                            selected: root.page == 2;
                            clicked => { root.page = 2; }
                        }
                        AdvancedListItem {
                            title: "下载";
                            icon: "download";
                            selected: root.page == 1;
                            clicked => { root.page = 1; root.refresh-versions(); }
                        }
                        ClassTitle { title: "通用"; }
                        AdvancedListItem {
                            title: "设置";
                            icon: "settings";
                            selected: root.page == 4;
                            clicked => { root.page = 4; }
                        }
                        AdvancedListItem {
                            title: "运行日志";
                            icon: "list-bulleted";
                            selected: root.page == 5;
                            clicked => { root.page = 5; }
                        }
                        AdvancedListItem {
                            title: "帮助";
                            icon: "help";
                            selected: false;
                            clicked => { root.open-help(); }
                        }
                    }
                    Text {
                        x: Theme.space-16;
                        y: parent.height - 28px;
                        text: "HDSL 0.1 · Rust";
                        color: Theme.on-surface-variant;
                        font-size: Theme.font-size-10;
                    }
                }

                Rectangle {
                    background: Theme.surface-transparent-50;
                    clip: true;

                    // Wallpaper, matching HMCL MainWindowPane's background node.
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: @image-url("assets/wallpapers/roxy-bot-light-gradient.jpg");
                        image-fit: cover;
                    }

                    // Pages are kept mounted and cross-faded on switch.
                    Rectangle {
                        width: parent.width;
                        height: parent.height;
                        visible: root.page == 0;
                        opacity: root.page == 0 ? 1 : 0;
                        animate opacity { duration: Theme.motion-short4; easing: ease-in-out; }
                        HomePage {
                            width: parent.width;
                            height: parent.height;
                            page <=> root.page;
                            active-instance-name: root.active-instance-name;
                            active-instance-version: root.active-instance-version;
                            active-instance-port: root.active-instance-port;
                            update-available: root.latest-version != "";
                            launch-instance => { root.launch-instance(); }
                            stop-instance => { root.stop-instance(); }
                            open-upstream-report => { root.open-upstream-report(); }
                        }
                    }
                    Rectangle {
                        width: parent.width;
                        height: parent.height;
                        visible: root.page == 1;
                        opacity: root.page == 1 ? 1 : 0;
                        animate opacity { duration: Theme.motion-short4; easing: ease-in-out; }
                        InstallPage {
                            width: parent.width;
                            height: parent.height;
                            page <=> root.page;
                            form-name <=> root.form-name;
                            form-version <=> root.form-version;
                            form-workspace <=> root.form-workspace;
                            available-versions: root.available-versions;
                            available-version-count: root.available-version-count;
                            refresh-versions => { root.refresh-versions(); }
                            create-instance(name, version, workspace, port) => { root.create-instance(name, version, workspace, port); }
                        }
                    }
                    Rectangle {
                        width: parent.width;
                        height: parent.height;
                        visible: root.page == 2;
                        opacity: root.page == 2 ? 1 : 0;
                        animate opacity { duration: Theme.motion-short4; easing: ease-in-out; }
                        InstancesPage {
                            width: parent.width;
                            height: parent.height;
                            page <=> root.page;
                            instances: root.instances;
                            selected-id <=> root.selected-id;
                            pending-delete-id <=> root.pending-delete-id;
                            select-instance(id) => { root.select-instance(id); }
                            launch-instance => { root.launch-instance(); }
                            clone-instance(id) => { root.clone-instance(id); }
                            refresh-instances => { root.refresh-instances(); }
                        }
                    }
                    Rectangle {
                        width: parent.width;
                        height: parent.height;
                        visible: root.page == 3;
                        opacity: root.page == 3 ? 1 : 0;
                        animate opacity { duration: Theme.motion-short4; easing: ease-in-out; }
                        PluginsPage {
                            width: parent.width;
                            height: parent.height;
                            page <=> root.page;
                            installed-plugins: root.installed-plugins;
                            plugins: root.plugins;
                            pending-remove-plugin <=> root.pending-remove-plugin;
                            refresh-plugins(query) => { root.refresh-plugins(query); }
                            install-plugin(package, version, repo) => { root.install-plugin(package, version, repo); }
                        }
                    }
                    Rectangle {
                        width: parent.width;
                        height: parent.height;
                        visible: root.page == 4;
                        opacity: root.page == 4 ? 1 : 0;
                        animate opacity { duration: Theme.motion-short4; easing: ease-in-out; }
                        SettingsPage {
                            width: parent.width;
                            height: parent.height;
                            page <=> root.page;
                        }
                    }
                    Rectangle {
                        width: parent.width;
                        height: parent.height;
                        visible: root.page == 5;
                        opacity: root.page == 5 ? 1 : 0;
                        animate opacity { duration: Theme.motion-short4; easing: ease-in-out; }
                        LogPage {
                            width: parent.width;
                            height: parent.height;
                            log-text: root.log-text;
                        }
                    }
                    Rectangle {
                        width: parent.width;
                        height: parent.height;
                        visible: root.page == 6;
                        opacity: root.page == 6 ? 1 : 0;
                        animate opacity { duration: Theme.motion-short4; easing: ease-in-out; }
                        InstanceDetailPage {
                            width: parent.width;
                            height: parent.height;
                            page <=> root.page;
                            instance-name: root.active-instance-name;
                            instance-version: root.active-instance-version;
                            instance-port: root.active-instance-port;
                        }
                    }
                }
            }

            // --- Status bar ---
            Rectangle {
                height: 28px;
                background: Theme.surface-container-high;
                Text {
                    x: Theme.space-10;
                    text: root.status-text;
                    color: Theme.on-surface-variant;
                    font-size: Theme.font-size-12;
                    vertical-alignment: center;
                    height: parent.height;
                }
            }
        }
    }

    if root.pending-delete-id != "": Rectangle {
        background: #990e1c34;
        Rectangle { width: 370px; height: 165px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Theme.surface-container-high; border-radius: Theme.radius-4;
            VerticalLayout { padding: Theme.space-20; spacing: Theme.space-12;
                Text { text: "删除实例？"; font-size: Theme.font-size-18; font-weight: 700; color: Theme.on-surface; }
                Text { text: "实例目录及其中的 Harness 数据将被删除。"; font-size: Theme.font-size-13; color: Theme.on-surface-variant; }
                HorizontalLayout { spacing: Theme.space-10;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ActionButton { width: 95px; label: "取消"; clicked => { root.pending-delete-id = ""; } }
                    ActionButton { width: 95px; label: "确认删除"; primary: true;
                        clicked => { root.remove-instance(root.pending-delete-id); root.pending-delete-id = ""; } }
                }
            }
        }
    }
    if root.pending-remove-plugin != "": Rectangle {
        background: #990e1c34;
        Rectangle { width: 410px; height: 165px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Theme.surface-container-high; border-radius: Theme.radius-4;
            VerticalLayout { padding: Theme.space-20; spacing: Theme.space-12;
                Text { text: "卸载插件？"; font-size: Theme.font-size-18; font-weight: 700; color: Theme.on-surface; }
                Text { text: root.pending-remove-plugin; font-size: Theme.font-size-13; color: Theme.on-surface-variant; overflow: elide; }
                HorizontalLayout { spacing: Theme.space-10;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ActionButton { width: 95px; label: "取消"; clicked => { root.pending-remove-plugin = ""; } }
                    ActionButton { width: 95px; label: "确认卸载"; primary: true;
                        clicked => { root.remove-plugin(root.pending-remove-plugin); root.pending-remove-plugin = ""; } }
                }
            }
        }
    }
    if root.approval-pending: Rectangle {
        background: #bb0e1c34;
        Rectangle { width: 570px; height: 380px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Theme.surface-container-high; border-radius: Theme.radius-4;
            VerticalLayout { padding: Theme.space-22; spacing: Theme.space-12;
                Text { text: root.approval-title; font-size: Theme.font-size-18; font-weight: 700; color: Theme.on-surface; }
                Text { text: "此包将执行以下构建脚本。请逐项检查后决定。"; font-size: Theme.font-size-13; color: Theme.on-surface-variant; }
                ScrollView { vertical-stretch: 1;
                    Text { text: root.approval-body; font-family: "Consolas"; font-size: Theme.font-size-12; color: Theme.on-surface; wrap: word-wrap; }
                }
                HorizontalLayout { spacing: Theme.space-10;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ActionButton { width: 95px; label: "拒绝"; clicked => { root.approval-pending = false; root.approve-build(false); } }
                    ActionButton { width: 95px; label: "允许这次"; primary: true;
                        clicked => { root.approval-pending = false; root.approve-build(true); } }
                }
            }
        }
    }
}
